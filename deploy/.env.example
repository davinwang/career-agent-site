# LLM Configuration
LLM_PROVIDER=deepseek
LLM_MODEL=deepseek-chat
LLM_API_KEY=your-deepseek-api-key-here
LLM_BASE_URL=https://api.deepseek.com

# Server
PORT=4111
NODE_ENV=production

# Admin Credentials (used by seed script on first run)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-password
JWT_SECRET=change-this-to-a-random-64-char-secret

# Exposed port on host
EXPOSE_PORT=8090

# CORS (comma-separated origins allowed)
FRONTEND_ORIGINS=http://localhost:8090

# Database (inside container)
DATABASE_PATH=/app/data/db/job-agent.db

# Data directories (inside container)
UPLOAD_DIR=/app/data/uploads
REPO_DIR=/app/data/repos
FONT_DIR=/app/fonts

# GitHub OAuth App (for account binding; optional — PAT hosting works without)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
